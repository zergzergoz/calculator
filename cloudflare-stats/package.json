{
  "name": "odium-world-calculator-stats",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create odium-web-stats",
    "db:init": "wrangler d1 execute odium-web-stats --remote --file=./schema.sql",
    "stats": "node ./scripts/show-stats.mjs today",
    "stats:today": "node ./scripts/show-stats.mjs today",
    "stats:history": "node ./scripts/show-stats.mjs history"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
